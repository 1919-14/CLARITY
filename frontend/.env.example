# CLARITY Frontend Environment Configuration Example
# Copy this file to frontend/.env for local overrides.
# The base URL must include the /api/v1 namespace.
# Default points to the local Flask backend.

VITE_API_BASE_URL=http://127.0.0.1:5000/api/v1

# Optional request timeout in milliseconds (default: 15000).
# VITE_API_TIMEOUT_MS=15000
