# CLARITY Backend Environment Configuration Example
# Copy this file to backend/.env for local development overrides.
# DO NOT commit real secrets or production credentials.

FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=dev-clarity-secret-key-change-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Database configuration:
# For local MySQL: mysql+pymysql://clarity_user:password@localhost:3306/clarity_db
# For local SQLite development: sqlite:///clarity_dev.db
DATABASE_URL=sqlite:///clarity_dev.db

# Optional LLM Scientist (Issue #41). Disabled by default: deterministic
# discovery needs no credentials and no network access.
LLM_SCIENTIST_ENABLED=false
LLM_SCIENTIST_PROVIDER=groq
# Model name used for proposal calls; recorded as provenance.
LLM_SCIENTIST_MODEL=llama-3.3-70b-versatile

# Ordered credential slots. The provider starts at the next slot in round-robin
# order and rotates to the next configured key when one is rate limited. Only the
# 1-based slot index is recorded; key values are never logged or serialized.
LLM_SCIENTIST_CREDENTIAL_ENV_VARS=GROQ_API_KEY,GROQ_API_KEY_2,GROQ_API_KEY_3,GROQ_API_KEY_4,GROQ_API_KEY_5
# Safe placeholders only. Never commit real keys; leave unused slots empty.
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

LLM_SCIENTIST_MAX_PROPOSALS=3
LLM_SCIENTIST_TIMEOUT_SECONDS=20
LLM_SCIENTIST_MAX_RETRIES=1
LLM_SCIENTIST_MAX_TOKENS=1024
LLM_SCIENTIST_MAX_RESPONSE_CHARS=20000
LLM_SCIENTIST_MAX_CONTEXT_OBSERVATIONS=20
LLM_SCIENTIST_MAX_CONTEXT_HYPOTHESES=8
LLM_SCIENTIST_MAX_ROUNDS=3
LLM_SCIENTIST_TEMPERATURE=0.2
LLM_SCIENTIST_FALLBACK_POLICY=continue_deterministic

# ---------------------------------------------------------------------------
# Nodus Compute remote execution (Issue #12)
# Required only when NODUS_EXECUTION_MODE=nodus_remote.
# Leave NODUS_EXECUTION_MODE=mock for local development without a real account.
#
# NODUS_EXECUTION_MODE must always be set explicitly; there is no default:
#   nodus_remote  — execute on the real Nodus platform (requires NODUS_API_KEY)
#   local         — execute via a locally registered handler function
#   mock          — return a deterministic stub; never contacts the platform
#
# Automated tests must set NODUS_EXECUTION_MODE=mock; omitting the variable
# or using any other value will raise NodusConfigurationError before executing.
#
# To run the remote smoke test:
#   Set NODUS_EXECUTION_MODE=nodus_remote, fill NODUS_API_KEY, NODUS_APP_NAME,
#   and NODUS_FUNCTION_NAME, then run:
#     python -m app.nodus_smoke_test
# ---------------------------------------------------------------------------
NODUS_EXECUTION_MODE=mock
NODUS_APP_NAME=your-nodus-app-name
NODUS_FUNCTION_NAME=your-nodus-function-name
# Safe placeholder only. Never commit a real API key.
NODUS_API_KEY=your-nodus-api-key-here
NODUS_TIMEOUT_SECONDS=30
NODUS_MAX_RETRIES=2
# Optional: override the Nodus platform base URL (leave blank for default)
NODUS_BASE_URL=
